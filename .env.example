# --- Server ---
PORT=3011
HOST=0.0.0.0
LOG_LEVEL=info
# Set true only behind a reverse proxy that sets X-Forwarded-For.
TRUST_PROXY=false
# Serve HTTPS directly (PEM files). Leave empty when a reverse proxy terminates TLS.
TLS_CERT_PATH=
TLS_KEY_PATH=
# Request body limit, bytes.
BODY_LIMIT=65536

# --- Storage ---
DB_PATH=./data/ratelimit.db
# Where the automatic pre-migration snapshot is written. Empty = next to DB_PATH.
DB_BACKUP_DIR=

# --- Callers: id:secret[:role[:policies]], comma separated. Secrets >= 32 chars, unique. Generate: openssl rand -hex 32
# Roles: check (POST /v1/check, /v1/check/batch, /v1/release only), read (policies, usage, statistics),
# write (create and change policies and overrides, reset usage), readwrite (everything; default).
# policies: names the key may touch, joined with "+"; omitted = all. A scoped key cannot see or create other policies.
RATELIMIT_API_KEYS=atc-console:REPLACE_WITH_64_HEX_CHARS,atc-gateway:REPLACE_WITH_64_HEX_CHARS:check,shop-backend:REPLACE_WITH_64_HEX_CHARS:check:api+login
# Requests per key per minute against this service itself.
RATE_LIMIT_MAX=6000

# --- Limits ---
# Windows per policy; longest window in seconds (default 30 days); largest cost one check may consume; checks per batch request.
MAX_LIMITS=5
MAX_WINDOW_SEC=2592000
MAX_COST=1000000
MAX_BATCH=20
# Housekeeping interval (stale counters, expired overrides) and how long hourly statistics are kept.
CLEANUP_INTERVAL_SEC=60
STATS_RETENTION_DAYS=30

# --- Audit (optional): forward write and security events to the audit service. Both or neither. A write-role key: AUDIT_API_KEYS=atc-ratelimit:…:write
AUDIT_URL=
AUDIT_API_KEY=
